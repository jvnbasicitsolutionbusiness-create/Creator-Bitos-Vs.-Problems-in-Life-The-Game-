# -----------------------------------------------------------------------------
# CREATOR BITOS — server configuration (copy to .env or export before starting)
# -----------------------------------------------------------------------------

# Port / host the game server binds to
PORT=3000
HOST=0.0.0.0

# Secret used to sign session tokens. CHANGE THIS for any real deployment.
SESSION_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Player database provider: "json" (default) or "google-sheets"
# -----------------------------------------------------------------------------
DB_PROVIDER=json

# Local JSON store location (only used when DB_PROVIDER=json)
PLAYER_DB_FILE=./server/data/players.json

# -----------------------------------------------------------------------------
# Google Sheets player database (server-side only — NEVER shipped to the client)
# -----------------------------------------------------------------------------
# 1. Create a Google Cloud project and enable the Google Sheets API.
# 2. Create a service account, download its JSON key.
# 3. Share the spreadsheet with the service account email as an EDITOR.
# 4. Fill in:

# DB_PROVIDER=google-sheets
# GOOGLE_SHEET_ID=1AbC...yourSheetId...
# GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1AbC...yourSheetId.../edit
# GOOGLE_SHEET_TAB=Players
# GOOGLE_SERVICE_ACCOUNT_EMAIL=bitos-sheets@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Note: if these are missing or invalid, the server logs the reason and falls
# back to the local JSON store so the game stays playable.
